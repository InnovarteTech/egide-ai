#!/usr/bin/env python3
import argparse
import atexit
import signal
import http.client
import re
import shutil
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOP = {
    "connection", "keep-alive", "transfer-encoding", "te", "trailer", "upgrade",
    "proxy-authorization", "proxy-authenticate", "content-length", "host",
}
TEXT = ("text/", "application/javascript", "application/json", "application/xml", "image/svg+xml")
STATE = {"token": None, "public": None}


def options():
    parser = argparse.ArgumentParser(
        prog="egide-local",
        description="Publica um app local para uma avaliação autorizada da Égide AI, sem configurar domínio.",
    )
    parser.add_argument("--porta", type=int, required=True, help="porta do app local (ex.: 8080)")
    parser.add_argument("--rota", action="append", default=[], metavar="PREFIXO=PORTA",
                        help="envia um prefixo para outra porta local (ex.: /api=3001). Pode repetir.")
    parser.add_argument("--substituir", action="append", default=[], metavar="DE=PARA",
                        help="troca um texto nas respostas (ex.: http://localhost:3001=). Pode repetir.")
    parser.add_argument("--escuta", type=int, default=8099, help="porta do gateway (padrão 8099)")
    parser.add_argument("--token", help="código de verificação do ativo, se já tiver")
    parser.add_argument("--sem-tunel", action="store_true", help="não abre o túnel HTTPS")
    args = parser.parse_args()
    routes = []
    for item in args.rota:
        prefix, _, port = item.partition("=")
        if not prefix.startswith("/") or not port.isdigit():
            parser.error("use --rota /api=3001")
        routes.append((prefix.rstrip("/") or "/", int(port)))
    swaps = []
    for item in args.substituir:
        source, _, target = item.partition("=")
        if not source:
            parser.error("use --substituir DE=PARA")
        swaps.append((source.encode(), target.encode()))
    return args, sorted(routes, key=lambda route: -len(route[0])), swaps


ARGS, ROUTES, SWAPS = options()
STATE["token"] = ARGS.token


def upstream(path):
    for prefix, port in ROUTES:
        if path == prefix or path.startswith(prefix + "/"):
            return port
    return ARGS.porta


class Gateway(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    def send(self, status, body, headers):
        self.send_response(status)
        for name, value in headers:
            self.send_header(name, value)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def forward(self):
        path = self.path.split("?", 1)[0]
        if path == "/.well-known/egide-verification.txt" and self.command in ("GET", "HEAD"):
            if not STATE["token"]:
                return self.send(404, b"", [("Content-Type", "text/plain")])
            return self.send(200, STATE["token"].encode(), [("Content-Type", "text/plain")])

        port = upstream(path)
        if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
            return self.send(411, "Envie a requisição com Content-Length.".encode(), [("Content-Type", "text/plain; charset=utf-8")])
        size = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(size) if size else None
        headers = {name: value for name, value in self.headers.items() if name.lower() not in HOP}
        headers["Host"] = f"localhost:{port}"
        headers["X-Forwarded-Proto"] = "https"
        if self.headers.get("Host"):
            headers["X-Forwarded-Host"] = self.headers["Host"]
        try:
            connection = http.client.HTTPConnection("127.0.0.1", port, timeout=30)
            connection.request(self.command, self.path, body, headers)
            response = connection.getresponse()
            data = response.read()
        except (OSError, http.client.HTTPException):
            return self.send(502, "O app local não respondeu na porta {}.".format(port).encode(), [("Content-Type", "text/plain; charset=utf-8")])

        kind = response.getheader("Content-Type", "")
        if SWAPS and kind.startswith(TEXT) and not response.getheader("Content-Encoding"):
            for source, target in SWAPS:
                data = data.replace(source, target)
        public = "https://" + self.headers.get("Host", "")
        out = []
        for name, value in response.getheaders():
            if name.lower() in HOP:
                continue
            if name.lower() == "location":
                value = re.sub(r"^https?://(?:localhost|127\.0\.0\.1)(?::\d+)?", public, value)
            out.append((name, value))
        self.send(response.status, data, out)

    do_GET = do_HEAD = do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = forward


def tunnel():
    binary = shutil.which("cloudflared")
    if not binary:
        print("cloudflared não encontrado. Instale com: brew install cloudflared")
        return
    process = STATE["tunnel"] = subprocess.Popen(
        [binary, "tunnel", "--protocol", "http2", "--url", f"http://127.0.0.1:{ARGS.escuta}"],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
    )
    for line in process.stderr:
        match = re.search(r"https://[a-z0-9-]+\.trycloudflare\.com", line)
        if match and not STATE["public"]:
            STATE["public"] = match.group()
            print(f"\nEndereço público: {STATE['public']}")
            print("1. Na Égide AI, cadastre um ativo com essa origem.")
            print("2. Cole aqui o código de verificação exibido no ativo.\n")


def shutdown(*_):
    process = STATE.get("tunnel")
    if process and process.poll() is None:
        process.terminate()
    raise SystemExit(0)


def main():
    atexit.register(lambda: STATE.get("tunnel") and STATE["tunnel"].poll() is None and STATE["tunnel"].terminate())
    signal.signal(signal.SIGTERM, shutdown)
    server = ThreadingHTTPServer(("127.0.0.1", ARGS.escuta), Gateway)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    print(f"Gateway da Égide AI em http://127.0.0.1:{ARGS.escuta} → app na porta {ARGS.porta}")
    for prefix, port in ROUTES:
        print(f"  {prefix} → porta {port}")
    if not ARGS.sem_tunel:
        threading.Thread(target=tunnel, daemon=True).start()
    print("Atenção: qualquer pessoa com o endereço público acessa o app enquanto o comando roda.")
    print("Use dados de teste. Encerre com Ctrl+C para derrubar o endereço público.")
    try:
        while True:
            line = sys.stdin.readline()
            if not line:
                threading.Event().wait()
            token = line.strip()
            if re.fullmatch(r"[A-Za-z0-9]{32,64}", token):
                STATE["token"] = token
                print("Código registrado. Clique em Verificar domínio na Égide AI.")
            elif token:
                print("Código inválido. Copie o código completo do ativo.")
    except KeyboardInterrupt:
        print("\nEncerrado.")


if __name__ == "__main__":
    main()
